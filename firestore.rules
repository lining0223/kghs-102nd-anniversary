rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Security Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Bootstrapped Admin Verification
    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 's114017@ms2.kghs.kh.edu.tw' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint for Celebration Document
    function isValidCelebrationDoc(data) {
      return data.updatedAt is number &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // Health check collection for connectivity verification
    match /test/{testId} {
      allow get: if isValidId(testId);
      allow write: if isAdmin() && isValidId(testId);
    }

    // Live School Celebration Data Collection (Sync across all devices)
    match /celebration/{docId} {
      // Public Read: Students, teachers, alumni, and parents can view celebration schedules and info
      allow get, list: if isValidId(docId);

      // Writes restricted to verified administrators only
      allow create: if isValidId(docId) && isAdmin() && isValidCelebrationDoc(incoming());
      allow update: if isValidId(docId) && isAdmin() && isValidCelebrationDoc(incoming());
      allow delete: if isValidId(docId) && isAdmin();
    }

    // Administrators registry (protected)
    match /admins/{adminId} {
      allow get: if isAdmin() && isValidId(adminId);
      allow write: if false; // Role elevation strictly managed via console
    }
  }
}
